 {{ header }}{{ column_left }}

 <div id="content">
   <div class="page-header">
      <div class="container-fluid">
         <div class="pull-right">
            <button type="submit" form="form-mpgs-hosted-checkout" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
            <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
         </div>
         <h1>{{ heading_title }}</h1>
         <ul class="breadcrumb">
            {% for breadcrumb in breadcrumbs %}
            <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
            {% endfor %}
         </ul>
         <div class="version-info">
            <div class="module-version"><strong>{{ entry_module_version }}</strong> <span>{{ module_version }}</span></div>
            <div class="api-version"><strong>{{ entry_api_version }}</strong> <span>{{ api_version }}</span></div>
         </div>
      </div>
   </div>
   <div class="container-fluid">
      {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
         <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
      {% endif %}
      {% if error_credentials_validation %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_credentials_validation }}
         <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
      {% endif %}
      {% if update_message %}
      <div class="alert alert-info alert-dismissible"><i class="fa fa-info-circle"></i> {{ update_message|raw }}
         <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
      {% endif %}
      <div class="panel panel-default">
         <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
         </div>
         <div class="panel-body">
            {% if retrieve_success == 1 %}
            <div class="alert alert-success alert-dismissible"><i class="fa fa-check"></i> {{ text_retrieve }}</div>
            {% endif %}
            <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-mpgs-hosted-checkout" class="form-horizontal">
               <section class="integeration-settings">
                  <h2>{{ intgrn_sec_head }}</h2>
                  <span class="section-description" for="integeration-settings" class="col-12">{{ intgrn_sec_desc }}</span>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ help_title }}">{{ entry_status }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_status" id="module-status" class="form-control">
                           {% if payment_mpgs_hosted_checkout_status %}
                           <option value="1" selected="selected">{{ text_enabled }}</option>
                           <option value="0">{{ text_disabled }}</option>
                           {% else %}
                           <option value="1">{{ text_enabled }}</option>
                           <option value="0" selected="selected">{{ text_disabled }}</option>
                           {% endif %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group required">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ help_title }}">{{ entry_title }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_title" value="{{ payment_mpgs_hosted_checkout_title }}" id="entry-title" class="form-control" />
                        {% if error_title %}
                           <div class="text-danger">{{ error_title }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_initial_transaction }}">{{ entry_initial_transaction }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_initial_transaction" id="initial-transaction" class="form-control">
                           {% if payment_mpgs_hosted_checkout_initial_transaction == 'pay' %}
                           <option value="pay" selected="selected">{{ text_pay }}</option>
                           {% else %}
                           <option value="pay">{{ text_pay }}</option>
                           {% endif %}
                           {% if payment_mpgs_hosted_checkout_initial_transaction == 'authorize' %}
                           <option value="authorize" selected="selected">{{ text_authorize }}</option>
                           {% else %}
                           <option value="authorize">{{ text_authorize }}</option>
                           {% endif %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group" id="hc-type-container">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_checkout_interaction }}">{{ entry_hc_type }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_hc_type" id="hc-type" class="form-control">
                           {% if payment_mpgs_hosted_checkout_hc_type == 'redirect' %}
                           <option value="redirect" selected="selected">{{ text_redirect }}</option>
                           <option value="modal">{{ text_modal }}</option>
                           {% else %}
                           <option value="redirect">{{ text_redirect }}</option>
                           <option value="modal" selected="selected">{{ text_modal }}</option>
                           {% endif %}
                        </select>
                        <div id="browser-warning" class="browser-warning" style="margin-top:10px;color: red;">
                           Please be advised that only card payments are supported within the embedded checkout integration.
                        </div>
                     </div>
                  </div>
               </section>
               <section class="api-credentials sec-divider">
                  <h2>{{ api_creds_head }}</h2>
                  <span class="section-description" for="integeration-settings" class="col-12">{{ api_creds_desc }}</span>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_test_mode }}">{{ entry_test }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_test" id="test-mode" class="form-control">
                           {% if payment_mpgs_hosted_checkout_test %}
                           <option value="1" selected="selected">{{ text_yes }}</option>
                           <option value="0">{{ text_no }}</option>
                           {% else %}
                           <option value="1">{{ text_yes }}</option>
                           <option value="0" selected="selected">{{ text_no }}</option>
                           {% endif %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group required" id="custom-url-container">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_custom_gateway_url }}">{{ entry_api_gateway_other }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_api_gateway_other" value="{{ payment_mpgs_hosted_checkout_api_gateway_other }}" id="api-gateway-other" class="form-control" />
                        {% if error_api_gateway_other %}
                           <div class="text-danger">{{ error_api_gateway_other }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group required" id="live-merchant-container">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_merchant_id }}">{{ entry_live_merchant_id }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_live_merchant_id" value="{{ payment_mpgs_hosted_checkout_live_merchant_id }}" id="live-merchant-id" class="form-control" />
                        {% if error_live_merchant_id %}
                        <div class="text-danger">{{ error_live_merchant_id }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group required" id="live-password-container">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_api_password }}">{{ entry_live_api_password }}</span></label>
                     <div class="col-sm-9">
                        <input type="password" name="payment_mpgs_hosted_checkout_live_api_password" value="{{ payment_mpgs_hosted_checkout_live_api_password }}" id="live-api-password" class="form-control" />
                        {% if error_live_api_password %}
                        <div class="text-danger">{{ error_live_api_password }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group required" id="test-merchant-container">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_test_merchant_id }}">{{ entry_test_merchant_id }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_test_merchant_id" value="{{ payment_mpgs_hosted_checkout_test_merchant_id }}" id="test-merchant-id" class="form-control" />
                        {% if error_test_merchant_id %}
                        <div class="text-danger">{{ error_test_merchant_id }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group required" id="test-password-container">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_test_api_password }}">{{ entry_test_api_password }}</span></label>
                     <div class="col-sm-9">
                        <input type="password" name="payment_mpgs_hosted_checkout_test_api_password" value="{{ payment_mpgs_hosted_checkout_test_api_password }}" id="test-api-password" class="form-control" />
                        {% if error_test_api_password %}
                        <div class="text-danger">{{ error_test_api_password }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group" id="live-webhook-container">
                     <label class="col-sm-3 control-label" for="live-notification-secret"><span data-toggle="tooltip" title="{{ help_live_notification_secret }}">{{ entry_live_notification_secret }}</span></label>
                     <div class="col-sm-9">
                        <input type="password" name="payment_mpgs_hosted_checkout_live_notification_secret" value="{{ payment_mpgs_hosted_checkout_live_notification_secret }}" id="live-notification-secret" class="form-control" />
                     </div>
                  </div>
                  <div class="form-group" id="test-webhook-container">
                     <label class="col-sm-3 control-label" for="test-notification-secret"><span data-toggle="tooltip" title="{{ help_test_notification_secret }}">{{ entry_test_notification_secret }}</span></label>
                     <div class="col-sm-9">
                        <input type="password" name="payment_mpgs_hosted_checkout_test_notification_secret" value="{{ payment_mpgs_hosted_checkout_test_notification_secret }}" id="test-notification-secret" class="form-control" />
                     </div>
                  </div>
               </section>
               <section class="adtnl-configuration sec-divider">
                  <h2>{{ adtn_conf_head }}</h2>
                  <span class="section-description" for="integeration-settings" class="col-12">{{ adtn_conf_desc }}</span>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="input-debug"><span data-toggle="tooltip" title="{{ help_debug_mode }}">{{ entry_debug }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_debug" id="input-debug" class="form-control">
                           {% if payment_mpgs_hosted_checkout_debug %}
                           <option value="1" selected="selected">{{ text_yes }}</option>
                           <option value="0">{{ text_no }}</option>
                           {% else %}
                           <option value="1">{{ text_yes }}</option>
                           <option value="0" selected="selected">{{ text_no }}</option>
                           {% endif %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="order-id-prefix"><span data-toggle="tooltip" title="{{ help_order_id_prefix }}">{{ entry_order_id_prefix }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_order_id_prefix" value="{{ payment_mpgs_hosted_checkout_order_id_prefix }}" id="order-id-prefix" class="form-control" />
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="send-line-items"><span data-toggle="tooltip" title="{{ help_send_line_items }}">{{ entry_send_line_items }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_send_line_items" id="send-line-items" class="form-control">
                           {% if payment_mpgs_hosted_checkout_send_line_items %}
                           <option value="1" selected="selected">{{ text_yes }}</option>
                           <option value="0">{{ text_no }}</option>
                           {% else %}
                           <option value="1">{{ text_yes }}</option>
                           <option value="0" selected="selected">{{ text_no }}</option>
                           {% endif %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="send-line-items"><span data-toggle="tooltip" title="{{ info_approved_status }}">{{ entry_approved_status }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_approved_status_id" id="approved-status" class="form-control">
                           {% for order_status in order_statuses %}
                           {% if order_status.order_status_id == payment_mpgs_hosted_checkout_approved_status_id %}
                           <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                           {% else %}
                           <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                           {% endif %}
                           {% endfor %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="send-line-items"><span data-toggle="tooltip" title="{{ info_declined_status }}">{{ entry_declined_status }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_declined_status_id" id="declined-status" class="form-control">
                           {% for order_status in order_statuses %}
                           {% if order_status.order_status_id == payment_mpgs_hosted_checkout_declined_status_id %}
                           <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                           {% else %}
                           <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                           {% endif %}
                           {% endfor %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="send-line-items"><span data-toggle="tooltip" title="{{ info_pending_status }}">{{ entry_pending_status }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_pending_status_id" id="pending-status" class="form-control">
                           {% for order_status in order_statuses %}
                           {% if order_status.order_status_id == payment_mpgs_hosted_checkout_pending_status_id %}
                           <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                           {% else %}
                           <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                           {% endif %}
                           {% endfor %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="send-line-items"><span data-toggle="tooltip" title="{{ info_refund_status }}">{{ entry_refund_status }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_refund_status_id" id="refund-status" class="form-control">
                           {% for order_status in order_statuses %}
                           {% if order_status.order_status_id == payment_mpgs_hosted_checkout_refund_status_id %}
                           <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                           {% else %}
                           <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                           {% endif %}
                           {% endfor %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="send-line-items"><span data-toggle="tooltip" title="{{ info_risk_review_required_status }}">{{ entry_risk_review_status }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_risk_review_status_id" id="risk-review-status" class="form-control">
                           {% for order_status in order_statuses %}
                           {% if order_status.order_status_id == payment_mpgs_hosted_checkout_risk_review_status_id %}
                           <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                           {% else %}
                           <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                           {% endif %}
                           {% endfor %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="risk-declined-status"><span data-toggle="tooltip" title="{{ info_declined_by_risk_assessment }}">{{ entry_risk_declined_status }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_risk_declined_status_id" id="risk-declined-status" class="form-control">
                           {% for order_status in order_statuses %}
                           {% if order_status.order_status_id == payment_mpgs_hosted_checkout_risk_declined_status_id %}
                           <option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
                           {% else %}
                           <option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
                           {% endif %}
                           {% endfor %}
                        </select>
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="risk-declined-status"><span data-toggle="tooltip" title="{{ info_sort_order }}">{{ entry_sort_order }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_sort_order" value="{{ payment_mpgs_hosted_checkout_sort_order }}" id="sort-order" class="form-control" />
                     </div>
                  </div>
                  <div class="form-group" id="merchant-info-toggle-container">
                     <label class="col-sm-3 control-label" for="entry-title"><span data-toggle="tooltip" title="{{ info_merchant_desc }}">{{ entry_merchant_head }}</span></label>
                     <div class="col-sm-9">
                        <select name="payment_mpgs_hosted_checkout_merchant_info" id="merchant-info" class="form-control">
                           {% if payment_mpgs_hosted_checkout_merchant_info %}
                           <option value="1" selected="selected">{{ text_yes }}</option>
                           <option value="0">{{ text_no }}</option>
                           {% else %}
                           <option value="1">{{ text_yes }}</option>
                           <option value="0" selected="selected">{{ text_no }}</option>
                           {% endif %}
                        </select>
                     </div>
                  </div>
                <section class="merchant-information" id="merchant-information-section">
                  <div class="form-group required">
                     <label class="col-sm-3 control-label" for="entry-merchant-name"><span data-toggle="tooltip" title="{{ info_merchant_name }}">{{ entry_merchant_name }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_merchant_name" value="{{ payment_mpgs_hosted_checkout_merchant_name }}" id="entry-merchant-name" class="form-control" />
                        {% if error_merchant_name %}
                           <div class="text-danger">{{ error_merchant_name }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-merchant-adrs1"><span data-toggle="tooltip" title="{{ info_merchant_adrs1 }}">{{ entry_merchant_adrs1 }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_merchant_adrs1" value="{{ payment_mpgs_hosted_checkout_merchant_adrs1 }}" id="entry-merchant-adrs1" class="form-control" />
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-merchant-adrs2"><span data-toggle="tooltip" title="{{ info_merchant_adrs2 }}">{{ entry_merchant_adrs2 }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_merchant_adrs2" value="{{ payment_mpgs_hosted_checkout_merchant_adrs2 }}" id="entry-merchant-adrs2" class="form-control" />
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-merchant-postcode"><span data-toggle="tooltip" title="{{ info_merchant_postcode }}">{{ entry_merchant_postcode }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_merchant_postcode" value="{{ payment_mpgs_hosted_checkout_merchant_postcode }}" id="entry-merchant-postcode" class="form-control" />
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-merchant-country"><span data-toggle="tooltip" title="{{ info_merchant_country }}">{{ entry_merchant_country }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_merchant_country" value="{{ payment_mpgs_hosted_checkout_merchant_country }}" id="entry-merchant-country" class="form-control" />
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-merchant-country"><span data-toggle="tooltip" title="{{ info_merchant_email }}">{{ entry_merchant_email }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_merchant_email" value="{{ payment_mpgs_hosted_checkout_merchant_email }}" id="entry-merchant-email" class="form-control" />
                        {% if error_merchant_email %}
                           <div class="text-danger">{{ error_merchant_email }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group">
                     <label class="col-sm-3 control-label" for="entry-merchant-country"><span data-toggle="tooltip" title="{{ info_merchant_phone }}">{{ entry_merchant_phone }}</span></label>
                     <div class="col-sm-9">
                        <input type="text" name="payment_mpgs_hosted_checkout_merchant_phone" value="{{ payment_mpgs_hosted_checkout_merchant_phone }}" id="entry-merchant-phone" class="form-control" />
                        {% if error_merchant_phone %}
                           <div class="text-danger">{{ error_merchant_phone }}</div>
                        {% endif %}
                     </div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-3 control-label" for="input-image"><span data-toggle="tooltip" title="{{ info_merchant_logo }}">{{ entry_merchant_logo }}</span></label>
                    <div class="col-sm-9"><a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" width="140" height="140" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                        <input type="hidden" name="payment_mpgs_hosted_checkout_image" value="{{ image }}" id="input-image" />
                    </div>
                  </div>
               </section>
            </form>
         </div>
      </div>
   </div>
</div>

 {{ footer }}
 
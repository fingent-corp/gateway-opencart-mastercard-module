<script type="text/javascript" src="catalog/view/javascript/mpgs-hosted-checkout/mgps.js"></script>

<div id="embed-target"></div>

<div class="buttons">
    <div class="pull-right">
        {% if checkout_interaction == 'modal' %}
            <input id="embeded_payment_button" type="button" value="{{ button_confirm }}" class="btn btn-primary" onclick="window.mpgsManager.loadCheckoutLibrary();" />
        {% else %}
            <input id="redirect_payment_button" type="button" value="{{ button_confirm }}" class="btn btn-primary" onclick="window.mpgsManager.loadCheckoutLibraryPaymentPage();" />
        {% endif %}
    </div>
</div>

<script type="text/javascript">
/**
 * Wrap everything in a block scope to allow use of 'const' and 'let'.
 * We attach the functions to the 'window' object so the HTML 'onclick' can find them.
 */
{
    const jsonData = {{ jsonData|raw }};
    const hosted_checkout_js = "{{ hosted_checkout_js }}";

    // Create a global namespace object to avoid polluting the global window scope
    window.mpgsManager = {
        loadCheckoutLibrary: () => {
            const btn = $('#embeded_payment_button');
            btn.val("Loading...").prop('disabled', true);

            loadScript(hosted_checkout_js, () => {
                window.checkoutLoaded = true;
                initializeCheckout();
                Checkout.showEmbeddedPage('#embed-target');
                btn.addClass('d-none');
            });
        },

        loadCheckoutLibraryPaymentPage: () => {
            const btn = $('#redirect_payment_button');
            btn.val("Loading...").prop('disabled', true);

            loadScript(hosted_checkout_js, () => {
                window.checkoutLoaded = true;
                initializeCheckout();
                Checkout.showPaymentPage();
            });
        }
    };

    const initializeCheckout = () => {
        setCookie('mgps_sucesss_indicator', jsonData.success_indicator, 5);
        setCookie('mgps_order', jsonData.mgps_order_id, 5);
        setCookie('mgps_OCSESSID', jsonData.OCSESSID, 5);
        setCookie('order_id', jsonData.order_id, 5);

        // Clear any stale MPGS session data left by the Checkout.js library from a
        // previous payment so the library always starts with the new session below.
        sessionStorage.removeItem('HostedCheckout_sessionId');
        if (typeof cleanupBrowserSession === 'function') cleanupBrowserSession();

        Checkout.configure({
            session: { id: jsonData.session_id }
        });
    };

    const setCookie = (name, value, minutesToExpire) => {
        const date = new Date();
        date.setTime(date.getTime() + (minutesToExpire * 60 * 1000));
        const expires = "expires=" + date.toUTCString();
        document.cookie = `${name}=${value};${expires};path=/`;
    };

    /**
     * Called by the MPGS Checkout library after a successful payment in embedded/modal mode.
     * Redirects to the server-side handler that processes and confirms the order.
     */
    window.completeCallback = function(resultIndicator, sessionVersion) {
        window.location.href = jsonData.completeCallback + '&resultIndicator=' + encodeURIComponent(resultIndicator);
    };

    /**
     * Called by the MPGS Checkout library when the customer cancels in embedded/modal mode.
     * Redirects to the server-side handler that marks the order as cancelled.
     */
    window.cancelCallback = function() {
        if (confirm('Are you sure you want to cancel the payment?')) {
            window.location.href = jsonData.cancelCallback;
        }
    };
}
</script>
